# Copy to .env for local development. All values are optional in development.
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# sqlite (default in development/test) or postgres (default in production)
DB_DIALECT=sqlite
SQLITE_STORAGE=db/dev.sqlite

# PostgreSQL (used when DB_DIALECT=postgres)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=postgres

# Optional Redis cache. Without it the API works uncached.
# REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call the API cross-origin.
CORS_ORIGINS=http://localhost:3000
