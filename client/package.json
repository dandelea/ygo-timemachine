{
  "name": "ygo-timemachine-client",
  "description": "Explorador de cartas de Yu-Gi-Oh! filtrado por épocas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "author": {
    "email": "danirele10@hotmail.com",
    "name": "Daniel de los Reyes Leal",
    "url": "http://danieldelosreyesleal.com"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "url": "https://github.com/dandelea/ygo-timemachine",
    "type": "git"
  },
  "keywords": [
    "Daniel de los Reyes",
    "Portfolio",
    "Vue",
    "NodeJS",
    "Redis",
    "Docker",
    "Postgres",
    "yugioh",
    "Yu-Gi-Oh!",
    "Timemachine"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@vuepic/vue-datepicker": "14.0.0",
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-easy-dnd": "3.0.0",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pinia/testing": "2.0.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "allowScripts": {
    "vue-demi": false
  }
}
